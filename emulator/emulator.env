# Source in a subshell to point the AWS CLI/SDKs at the local AWS Emulator:
#   ( . emulator/emulator.env && aws sts get-caller-identity )   # expect Account 000000000000
# Files under ~/.aws/emulator/<port>/ are regenerated on every emulator start; never commit them.
EMULATOR_PORT=${EMULATOR_PORT:-9297}
export AWS_ENDPOINT_URL=https://127.0.0.1:${EMULATOR_PORT}
export AWS_SHARED_CREDENTIALS_FILE=$HOME/.aws/emulator/${EMULATOR_PORT}/emulator_credentials
export AWS_CONFIG_FILE=$HOME/.aws/emulator/${EMULATOR_PORT}/config
export AWS_EC2_METADATA_DISABLED=true
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1

# Real credentials in the environment would win over the credentials file: drop them.
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE \
  AWS_WEB_IDENTITY_TOKEN_FILE AWS_ROLE_ARN AWS_ROLE_SESSION_NAME AWS_CONTAINER_CREDENTIALS_RELATIVE_URI \
  AWS_CONTAINER_CREDENTIALS_FULL_URI AWS_CONTAINER_AUTHORIZATION_TOKEN

# In Docker the generated config's ca_bundle is a container path, so point clients at the host copy.
export AWS_CA_BUNDLE=$HOME/.aws/emulator/${EMULATOR_PORT}/ca.pem
# Rust-based clients (pydynox) ignore AWS_CA_BUNDLE; they read SSL_CERT_FILE.
export SSL_CERT_FILE=$HOME/.aws/emulator/${EMULATOR_PORT}/ca.pem
export AWS_PAGER=""
